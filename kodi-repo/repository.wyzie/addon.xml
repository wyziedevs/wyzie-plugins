<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.wyzie"
       name="Wyzie Repository"
       version="1.0.0"
       provider-name="Wyzie">
  <extension point="xbmc.addon.repository" name="Wyzie Repository">
    <dir>
      <!-- CHANGE these three URLs to wherever you host the built files
           (e.g. https://kodi.wyzie.io/ or your GitHub Pages URL). They must
           point at the addons.xml, its md5, and the zips/ directory produced
           by build.sh. -->
      <info compressed="false">https://kodi.wyzie.io/addons.xml</info>
      <checksum>https://kodi.wyzie.io/addons.xml.md5</checksum>
      <datadir zip="true">https://kodi.wyzie.io/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Wyzie Subs add-ons for Kodi</summary>
    <description lang="en_GB">Official repository for Wyzie Subs Kodi add-ons. Install the Wyzie Subs subtitle service and receive automatic updates.</description>
    <platform>all</platform>
    <license>MIT</license>
    <website>https://sub.wyzie.io</website>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
